@model IEnumerable<SampleForHandsOnExp_MVC_WebApplication.Models.Employee>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
    <div> 
        <h2>Employee Names</h2>
        @foreach(SampleForHandsOnExp_MVC_WebApplication.Models.Employee emp in Model)
        {
            @Html.ActionLink(emp.EmployeeName, "Details", new { id = emp.EmployeeId });
            <br />
        }
        @Html.ActionLink("Back", "Index", "Department");
    </div>
</body>
</html>
