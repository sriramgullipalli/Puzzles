@model SampleForHandsOnExp_MVC_WebApplication.Models.Employee

@{
    ViewBag.Title = "Employee Details";
    Layout = null;

}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Details</title>
</head>
<body>
    <div> 
        <h2>Employee Details</h2>
        <table>
            <tr>
                <td>
                    Employee Id :
                </td>
                <td>
                    @Model.EmployeeId
                </td>
            </tr>
            <tr>
                <td>
                    Employee Name :
                </td>
                <td>
                    @Model.EmployeeName
                </td>
            </tr>
            <tr>
                <td>
                    Dept Id :
                </td>
                <td>
                    @Model.DeptId
                </td>
            </tr>
            <tr>
                <td>
                    Salary :
                </td>
                <td>
                    @Model.Salary
                </td>
            </tr>
        </table>

        @Html.ActionLink("Back", "Index", "Employee", new {id = Model.DeptId}, null)
    </div>
</body>
</html>
